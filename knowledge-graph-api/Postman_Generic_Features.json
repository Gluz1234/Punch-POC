{
    "info":  {
                 "name":  "Knowledge Graph - Generic Features v3 (Header Auth + Property Security)",
                 "version":  "3.0.0",
                 "schema":  "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
             },
    "item":  [
                 {
                     "name":  "1. FULL-TEXT SEARCH",
                     "item":  [
                                  {
                                      "name":  "Search: Basic Person Query",
                                      "request":  {
                                                      "method":  "GET",
                                                      "url":  "{{base_url}}/search/person?q=john",
                                                      "description":  "Simple search across default text fields"
                                                  }
                                  },
                                  {
                                      "name":  "Search: Field-Scoped Query",
                                      "request":  {
                                                      "method":  "GET",
                                                      "url":  "{{base_url}}/search/person?q=john\u0026fields=first_name,last_name\u0026limit=25",
                                                      "description":  "Search only specific fields"
                                                  }
                                  },
                                  {
                                      "name":  "Search: Prefix and Fuzzy",
                                      "request":  {
                                                      "method":  "GET",
                                                      "url":  "{{base_url}}/search/person?q=john*\u0026limit=20",
                                                      "description":  "Use operators like prefix (*), fuzzy (~), phrase, AND/OR"
                                                  }
                                  },
                                  {
                                      "name":  "Autocomplete: Person Name",
                                      "request":  {
                                                      "method":  "GET",
                                                      "url":  "{{base_url}}/search/person/autocomplete?q=jo\u0026fields=first_name,last_name\u0026limit=10",
                                                      "description":  "Autocomplete suggestions across multiple fields"
                                                  }
                                  },
                                  {
                                      "name":  "Autocomplete: Tenant Scoped",
                                      "request":  {
                                                      "method":  "GET",
                                                      "url":  "{{base_url}}/search/person/autocomplete?q=jo\u0026field=first_name\u0026limit=10",
                                                      "description":  "Autocomplete limited to tenant-scoped relationships"
                                                  }
                                  },
                                  {
                                      "name":  "Advanced Search: Full Dynamic Example",
                                      "request":  {
                                                      "method":  "POST",
                                                      "url":  "{{base_url}}/search/person/query",
                                                      "header":  [
                                                                     {
                                                                         "key":  "Content-Type",
                                                                         "value":  "application/json"
                                                                     }
                                                                 ],
                                                      "body":  {
                                                                   "mode":  "raw",
                                                                   "raw":  "{\n  \"q\": \"john\",\n  \"fields\": [\"first_name\", \"last_name\"],\n  \"fieldQueries\": [\n    {\n      \"field\": \"email\",\n      \"query\": \"gmail.com\",\n      \"operator\": \"contains\",\n      \"boost\": 1.5\n    }\n  ],\n  \"ranges\": [\n    {\n      \"field\": \"birth_date\",\n      \"gte\": \"1990-01-01\"\n    }\n  ],\n  \"relationships\": [\n    {\n      \"type\": \"WORKS_AT\",\n      \"direction\": \"OUTGOING\",\n      \"entity\": \"organization\",\n      \"targetFilters\": {\n        \"org_id\": \"ORG_001\"\n      },\n      \"query\": \"mit\",\n      \"fields\": [\"name\"]\n    }\n  ],\n  \"facets\": [\n    {\n      \"field\": \"status\",\n      \"limit\": 10\n    }\n  ],\n  \"aggregations\": [\n    {\n      \"operation\": \"count\",\n      \"name\": \"total_results\"\n    },\n    {\n      \"operation\": \"countDistinct\",\n      \"field\": \"nationality\",\n      \"name\": \"unique_nationalities\"\n    }\n  ],\n  \"explain\": true,\n  \"tenantId\": \"TENANT_1\",\n  \"limit\": 25\n}"
                                                               },
                                                      "description":  "Field filters + ranges + relationship filters + facets + aggregations + explain"
                                                  }
                                  },
                                  {
                                      "name":  "Advanced Search: Relationship Aware",
                                      "request":  {
                                                      "method":  "POST",
                                                      "url":  "{{base_url}}/search/person/query",
                                                      "header":  [
                                                                     {
                                                                         "key":  "Content-Type",
                                                                         "value":  "application/json"
                                                                     }
                                                                 ],
                                                      "body":  {
                                                                   "mode":  "raw",
                                                                   "raw":  "{\n  \"q\": \"engineer\",\n  \"relationships\": [\n    {\n      \"type\": \"WORKS_AT\",\n      \"direction\": \"OUTGOING\",\n      \"entity\": \"organization\",\n      \"targetFilters\": {\n        \"org_id\": \"ORG_001\"\n      }\n    }\n  ],\n  \"explain\": true,\n  \"tenantId\": \"TENANT_1\",\n  \"limit\": 20\n}"
                                                               },
                                                      "description":  "Relationship-aware matching without hardcoded entity logic"
                                                  }
                                  },
                                  {
                                      "name":  "Search: Initialize Engine",
                                      "request":  {
                                                      "method":  "POST",
                                                      "url":  "{{base_url}}/search/init-indexes",
                                                      "description":  "Initialize and verify search engine capabilities"
                                                  }
                                  }
                              ]
                 },
                 {
                     "name":  "2. SIMPLIFIED QUERY (Tier 2)",
                     "item":  [
                                  {
                                      "name":  "Query: Get All Persons",
                                      "request":  {
                                                      "method":  "POST",
                                                      "url":  "{{base_url}}/search",
                                                      "body":  {
                                                                   "mode":  "raw",
                                                                   "raw":  "{\n  \"entity\": \"person\",\n  \"limit\": 50\n}"
                                                               },
                                                      "description":  "Get all persons (simplified query)"
                                                  }
                                  },
                                  {
                                      "name":  "Query: Get Persons at Organization",
                                      "request":  {
                                                      "method":  "POST",
                                                      "url":  "{{base_url}}/search",
                                                      "body":  {
                                                                   "mode":  "raw",
                                                                   "raw":  "{\n  \"entity\": \"person\",\n  \"relationships\": [\n    {\n      \"type\": \"WORKS_AT\",\n      \"target\": \"organization\",\n      \"filters\": { \"org_id\": \"ORG_001\" }\n    }\n  ],\n  \"tenantId\": \"TENANT_1\",\n  \"limit\": 100\n}"
                                                               },
                                                      "description":  "Get all persons working at a specific organization"
                                                  }
                                  },
                                  {
                                      "name":  "Query: Get Persons with Multiple Relationships",
                                      "request":  {
                                                      "method":  "POST",
                                                      "url":  "{{base_url}}/search",
                                                      "body":  {
                                                                   "mode":  "raw",
                                                                   "raw":  "{\n  \"entity\": \"person\",\n  \"relationships\": [\n    {\n      \"type\": \"WORKS_AT\",\n      \"target\": \"organization\",\n      \"filters\": { \"org_id\": \"ORG_001\" }\n    },\n    {\n      \"type\": \"HAS_SKILL\",\n      \"target\": \"skill\",\n      \"filters\": { \"skill_id\": \"JAVA\" }\n    }\n  ],\n  \"tenantId\": \"TENANT_1\",\n  \"limit\": 50\n}"
                                                               },
                                                      "description":  "Get persons working at organization AND who have Java skill"
                                                  }
                                  },
                                  {
                                      "name":  "Query: Get Persons Enrolled at Organization",
                                      "request":  {
                                                      "method":  "POST",
                                                      "url":  "{{base_url}}/search",
                                                      "body":  {
                                                                   "mode":  "raw",
                                                                   "raw":  "{\n  \"entity\": \"person\",\n  \"relationships\": [\n    {\n      \"type\": \"ENROLLED_IN\",\n      \"target\": \"organization\",\n      \"filters\": { \"org_id\": \"ORG_MIT\" }\n    }\n  ],\n  \"tenantId\": \"TENANT_1\",\n  \"limit\": 100\n}"
                                                               },
                                                      "description":  "Get all persons enrolled in a specific organization"
                                                  }
                                  },
                                  {
                                      "name":  "Query: Get Persons Living in Location",
                                      "request":  {
                                                      "method":  "POST",
                                                      "url":  "{{base_url}}/search",
                                                      "body":  {
                                                                   "mode":  "raw",
                                                                   "raw":  "{\n  \"entity\": \"person\",\n  \"relationships\": [\n    {\n      \"type\": \"LIVES_IN\",\n      \"target\": \"location\",\n      \"filters\": { \"location_id\": \"CITY_NYC\" }\n    }\n  ],\n  \"tenantId\": \"TENANT_1\",\n  \"limit\": 50\n}"
                                                               },
                                                      "description":  "Get all persons living in a specific location"
                                                  }
                                  }
                              ]
                 },
                 {
                     "name":  "3. GENERIC QUERY BUILDER (Tier 3 - Advanced)",
                     "item":  [
                                  {
                                      "name":  "Advanced: Dynamic Query - Complex",
                                      "request":  {
                                                      "method":  "POST",
                                                      "url":  "{{base_url}}/query/execute",
                                                      "body":  {
                                                                   "mode":  "raw",
                                                                   "raw":  "{\n  \"mainEntity\": {\n    \"config\": { \"label\": \"Person\", \"idField\": \"strong_id\" },\n    \"alias\": \"p\"\n  },\n  \"relationships\": [\n    {\n      \"type\": \"WORKS_AT\",\n      \"direction\": \"-\u003e\",\n      \"targetEntity\": {\n        \"config\": { \"label\": \"Organization\", \"idField\": \"org_id\" },\n        \"alias\": \"o\",\n        \"filterFields\": { \"org_id\": \"ORG_001\" }\n      }\n    },\n    {\n      \"type\": \"HAS_SKILL\",\n      \"direction\": \"-\u003e\",\n      \"targetEntity\": {\n        \"config\": { \"label\": \"Skill\", \"idField\": \"skill_id\" },\n        \"alias\": \"s\"\n      }\n    }\n  ],\n  \"returns\": [\"p\", \"labels(p) AS labels\", \"o.name AS orgName\", \"s.name AS skillName\"],\n  \"tenantId\": \"TENANT_1\",\n  \"orderBy\": \"p.last_name\",\n  \"limit\": 50,\n  \"distinct\": true\n}"
                                                               },
                                                      "description":  "Full generic query builder - persons working at org who have skills"
                                                  }
                                  }
                              ]
                 },
                 {
                     "name":  "4. BASIC CRUD (for context)",
                     "item":  [
                                  {
                                      "name":  "CRUD: Create Person",
                                      "request":  {
                                                      "method":  "POST",
                                                      "url":  "{{base_url}}/persons",
                                                      "body":  {
                                                                   "mode":  "raw",
                                                                   "raw":  "{\n  \"strong_id\": \"P_001\",\n  \"first_name\": \"John\",\n  \"last_name\": \"Smith\",\n  \"email\": \"john.smith@example.com\",\n  \"phone\": \"+1-555-0100\",\n  \"nationality\": \"USA\",\n  \"status\": \"Active\",\n  \"birth_date\": \"1990-05-15\"\n}"
                                                               },
                                                      "description":  "Create or upsert a person entity"
                                                  }
                                  },
                                  {
                                      "name":  "CRUD: Get All Persons (basic)",
                                      "request":  {
                                                      "method":  "GET",
                                                      "url":  "{{base_url}}/persons?limit=50",
                                                      "description":  "Get all persons with pagination"
                                                  }
                                  },
                                  {
                                      "name":  "CRUD: Get Single Person",
                                      "request":  {
                                                      "method":  "GET",
                                                      "url":  "{{base_url}}/persons/P_001",
                                                      "description":  "Get a person by ID"
                                                  }
                                  },
                                  {
                                      "name":  "CRUD: Update Person",
                                      "request":  {
                                                      "method":  "PUT",
                                                      "url":  "{{base_url}}/persons/P_001",
                                                      "body":  {
                                                                   "mode":  "raw",
                                                                   "raw":  "{\n  \"email\": \"john.doe@newcompany.com\",\n  \"phone\": \"+1-555-0200\",\n  \"status\": \"Inactive\"\n}"
                                                               },
                                                      "description":  "Update specific fields of a person"
                                                  }
                                  },
                                  {
                                      "name":  "CRUD: Delete Person",
                                      "request":  {
                                                      "method":  "DELETE",
                                                      "url":  "{{base_url}}/persons/P_001",
                                                      "description":  "Delete a person and all their relationships"
                                                  }
                                  }
                              ]
                 },
                 {
                     "name":  "5. RELATIONSHIPS (for context)",
                     "item":  [
                                  {
                                      "name":  "Relationship: Create WORKS_AT",
                                      "request":  {
                                                      "method":  "POST",
                                                      "url":  "{{base_url}}/relationships",
                                                      "body":  {
                                                                   "mode":  "raw",
                                                                   "raw":  "{\n  \"sourceId\": \"P_001\",\n  \"targetId\": \"ORG_001\",\n  \"relationshipType\": \"WORKS_AT\",\n  \"tenantId\": \"TENANT_1\",\n  \"properties\": {\n    \"jobTitle\": \"Software Engineer\",\n    \"startDate\": \"2023-01-15\"\n  }\n}"
                                                               },
                                                      "description":  "Create a WORKS_AT relationship between person and organization"
                                                  }
                                  },
                                  {
                                      "name":  "Relationship: Create HAS_SKILL",
                                      "request":  {
                                                      "method":  "POST",
                                                      "url":  "{{base_url}}/relationships",
                                                      "body":  {
                                                                   "mode":  "raw",
                                                                   "raw":  "{\n  \"sourceId\": \"P_001\",\n  \"targetId\": \"JAVA\",\n  \"relationshipType\": \"HAS_SKILL\",\n  \"tenantId\": \"TENANT_1\",\n  \"properties\": {\n    \"proficiency\": \"Expert\",\n    \"yearsOfExperience\": 5\n  }\n}"
                                                               },
                                                      "description":  "Create a HAS_SKILL relationship"
                                                  }
                                  },
                                  {
                                      "name":  "Relationship: Get Person Relationships",
                                      "request":  {
                                                      "method":  "GET",
                                                      "url":  "{{base_url}}/relationships/P_001",
                                                      "description":  "Get all relationships for a person"
                                                  }
                                  },
                                  {
                                      "name":  "Relationship: Delete WORKS_AT",
                                      "request":  {
                                                      "method":  "DELETE",
                                                      "url":  "{{base_url}}/relationships/P_001/WORKS_AT?targetId=ORG_001",
                                                      "description":  "Delete a specific relationship"
                                                  }
                                  }
                              ]
                 },
                 {
                     "name":  "6. IDENTITY + TENANT SCHEMA",
                     "item":  [
                                  {
                                      "name":  "Identity: Resolve Canonical ID",
                                      "request":  {
                                                      "method":  "GET",
                                                      "url":  "{{base_url}}/identity/P_001/canonical",
                                                      "description":  "Resolve canonical entity_id after merge workflows"
                                                  }
                                  },
                                  {
                                      "name":  "Identity: Possible Duplicates",
                                      "request":  {
                                                      "method":  "GET",
                                                      "url":  "{{base_url}}/identity/P_001/possible-duplicates?limit=5",
                                                      "description":  "Get duplicate suggestions with score and reasons"
                                                  }
                                  },
                                  {
                                      "name":  "Identity: Merge Entities",
                                      "request":  {
                                                      "method":  "POST",
                                                      "url":  "{{base_url}}/identity/merge",
                                                      "header":  [
                                                                     {
                                                                         "key":  "Content-Type",
                                                                         "value":  "application/json"
                                                                     }
                                                                 ],
                                                      "body":  {
                                                                   "mode":  "raw",
                                                                   "raw":  "{\n  \"primaryEntityId\": \"P_001\",\n  \"duplicateEntityId\": \"P_001_DUP\",\n  \"reason\": \"manual validation\"\n}"
                                                               },
                                                      "description":  "Merge duplicate into primary identity"
                                                  }
                                  },
                                  {
                                      "name":  "Identity: Unmerge by Merge ID",
                                      "request":  {
                                                      "method":  "POST",
                                                      "url":  "{{base_url}}/identity/unmerge/REPLACE_WITH_MERGE_ID",
                                                      "description":  "Revert a previous merge event"
                                                  }
                                  },
                                  {
                                      "name":  "Promotions: All Base Types",
                                      "request":  {
                                                      "method":  "GET",
                                                      "url":  "{{base_url}}/promotions/schema/base-types",
                                                      "description":  "List configured/custom base labels and subtype counts"
                                                  }
                                  },
                                  {
                                      "name":  "Promotions: Types by Tenant",
                                      "request":  {
                                                      "method":  "GET",
                                                      "url":  "{{base_url}}/promotions/schema/tenant/types",
                                                      "description":  "List base/subtype/unknown labels used in a tenant"
                                                  }
                                  },
                                  {
                                      "name":  "Schema: Tenant Snapshot",
                                      "request":  {
                                                      "method":  "GET",
                                                      "url":  "{{base_url}}/schema/tenant/schema",
                                                      "description":  "Get tenant-scoped schema labels and relationship types"
                                                  }
                                  }
                              ]
                 }
             ],
    "variable":  [
                     {
                         "key":  "base_url",
                         "value":  "http://localhost:3000/api",
                         "type":  "string"
                     },
                     {
                         "key":  "authz_user_id",
                         "value":  "014d58c0-e788-4e53-bfa3-7986f242e7e1"
                     },
                     {
                         "key":  "authz_username",
                         "value":  "testing@example.com"
                     },
                     {
                         "key":  "authz_read",
                         "value":  "true"
                     },
                     {
                         "key":  "authz_write",
                         "value":  "true"
                     },
                     {
                         "key":  "authz_is_admin",
                         "value":  "false"
                     },
                     {
                         "key":  "authz_env_level",
                         "value":  "6"
                     },
                     {
                         "key":  "x_tenant_id",
                         "value":  "tenant_mit"
                     }
                 ],
    "event":  [
                  {
                      "listen":  "prerequest",
                      "script":  {
                                     "type":  "text/javascript",
                                     "exec":  [
                                                  "var tenant = pm.collectionVariables.get(\u0027x_tenant_id\u0027) || \u0027tenant_mit\u0027;",
                                                  "pm.request.headers.upsert({ key: \u0027x-authz-user-id\u0027,    value: pm.collectionVariables.get(\u0027authz_user_id\u0027)    || \u0027014d58c0-e788-4e53-bfa3-7986f242e7e1\u0027 });",
                                                  "pm.request.headers.upsert({ key: \u0027x-authz-username\u0027,   value: pm.collectionVariables.get(\u0027authz_username\u0027)   || \u0027testing@example.com\u0027 });",
                                                  "pm.request.headers.upsert({ key: \u0027x-authz-read\u0027,       value: pm.collectionVariables.get(\u0027authz_read\u0027)       || \u0027true\u0027 });",
                                                  "pm.request.headers.upsert({ key: \u0027x-authz-write\u0027,      value: pm.collectionVariables.get(\u0027authz_write\u0027)      || \u0027true\u0027 });",
                                                  "pm.request.headers.upsert({ key: \u0027x-authz-is-admin\u0027,   value: pm.collectionVariables.get(\u0027authz_is_admin\u0027)   || \u0027false\u0027 });",
                                                  "pm.request.headers.upsert({ key: \u0027x-authz-env-\u0027 + tenant, value: pm.collectionVariables.get(\u0027authz_env_level\u0027) || \u00276\u0027 });",
                                                  "pm.request.headers.upsert({ key: \u0027x-tenant-id\u0027,        value: tenant });"
                                              ]
                                 }
                  }
              ]
}
