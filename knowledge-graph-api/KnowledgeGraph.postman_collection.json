      { "name": "WORKS_AT",         "request": { "method": "POST", "url": "{{base}}/relationships/works-at",        "header": [{"key":"Content-Type","value":"application/json"}], "body": { "mode":"raw","raw":"{\n  \"personStrongId\": \"person-sarah-chen\",\n  \"orgId\": \"org-google\",\n  \"tenantId\": \"tenant_google\",\n  \"jobTitle\": \"Software Engineer L4\"\n}" } } },
      { "name": "LIVES_IN",         "request": { "method": "POST", "url": "{{base}}/relationships/lives-in",        "header": [{"key":"Content-Type","value":"application/json"}], "body": { "mode":"raw","raw":"{\n  \"personStrongId\": \"person-sarah-chen\",\n  \"locationId\": \"loc-amsterdam\",\n  \"tenantId\": \"tenant_mit\",\n  \"residenceType\": \"Primary\"\n}" } } },
      { "name": "HAS_SKILL",        "request": { "method": "POST", "url": "{{base}}/relationships/has-skill",       "header": [{"key":"Content-Type","value":"application/json"}], "body": { "mode":"raw","raw":"{\n  \"personStrongId\": \"person-sarah-chen\",\n  \"skillId\": \"skill-python\",\n  \"tenantId\": \"tenant_mit\",\n  \"proficiencyLevel\": \"Expert\"\n}" } } },
      { "name": "COMPLETED",        "request": { "method": "POST", "url": "{{base}}/relationships/completed",       "header": [{"key":"Content-Type","value":"application/json"}], "body": { "mode":"raw","raw":"{\n  \"personStrongId\": \"person-sarah-chen\",\n  \"educationId\": \"edu-cs-mit\",\n  \"tenantId\": \"tenant_mit\"\n}" } } },
      { "name": "PROVIDED_BY",      "request": { "method": "POST", "url": "{{base}}/relationships/provided-by",     "header": [{"key":"Content-Type","value":"application/json"}], "body": { "mode":"raw","raw":"{\n  \"educationId\": \"edu-cs-mit\",\n  \"orgId\": \"org-mit\",\n  \"tenantId\": \"tenant_mit\"\n}" } } },
      { "name": "REQUIRES_SKILL",   "request": { "method": "POST", "url": "{{base}}/relationships/requires-skill",  "header": [{"key":"Content-Type","value":"application/json"}], "body": { "mode":"raw","raw":"{\n  \"orgId\": \"org-google\",\n  \"skillId\": \"skill-python\",\n  \"tenantId\": \"tenant_google\",\n  \"requirementLevel\": \"Expert\"\n}" } } },
      { "name": "HAS_ADVISOR",      "request": { "method": "POST", "url": "{{base}}/relationships/has-advisor",     "header": [{"key":"Content-Type","value":"application/json"}], "body": { "mode":"raw","raw":"{\n  \"studentStrongId\": \"person-sarah-chen\",\n  \"advisorStrongId\": \"person-prof-johnson\",\n  \"tenantId\": \"tenant_mit\",\n  \"advisorRole\": \"Primary\"\n}" } } },
      { "name": "REGISTERED_FOR",   "request": { "method": "POST", "url": "{{base}}/relationships/registered-for",  "header": [{"key":"Content-Type","value":"application/json"}], "body": { "mode":"raw","raw":"{\n  \"studentStrongId\": \"person-sarah-chen\",\n  \"courseId\": \"course-6006\",\n  \"tenantId\": \"tenant_mit\",\n  \"status\": \"Enrolled\"\n}" } } },
      { "name": "REPORTS_TO",       "request": { "method": "POST", "url": "{{base}}/relationships/reports-to",      "header": [{"key":"Content-Type","value":"application/json"}], "body": { "mode":"raw","raw":"{\n  \"employeeStrongId\": \"person-sarah-chen\",\n  \"managerStrongId\": \"person-yuki-tanaka\",\n  \"tenantId\": \"tenant_google\",\n  \"reportingType\": \"Direct\"\n}" } } },
      { "name": "WORKS_IN",         "request": { "method": "POST", "url": "{{base}}/relationships/works-in",        "header": [{"key":"Content-Type","value":"application/json"}], "body": { "mode":"raw","raw":"{\n  \"employeeStrongId\": \"person-sarah-chen\",\n  \"departmentId\": \"dept-google-cloud\",\n  \"tenantId\": \"tenant_google\",\n  \"role\": \"Software Engineer\"\n}" } } },
      { "name": "REGISTERED_AT",    "request": { "method": "POST", "url": "{{base}}/relationships/registered-at",   "header": [{"key":"Content-Type","value":"application/json"}], "body": { "mode":"raw","raw":"{\n  \"residentStrongId\": \"person-leon-fischer\",\n  \"locationId\": \"loc-amsterdam\",\n  \"tenantId\": \"tenant_city_nl\",\n  \"addressType\": \"Primary\"\n}" } } },
      { "name": "AFFILIATED_WITH",  "request": { "method": "POST", "url": "{{base}}/relationships/affiliated-with", "header": [{"key":"Content-Type","value":"application/json"}], "body": { "mode":"raw","raw":"{\n  \"researcherStrongId\": \"person-sarah-chen\",\n  \"orgId\": \"org-mit\",\n  \"tenantId\": \"tenant_mit\",\n  \"affiliationType\": \"PhD Candidate\"\n}" } } },
      { "name": "OFFERED_BY",       "request": { "method": "POST", "url": "{{base}}/relationships/offered-by",      "header": [{"key":"Content-Type","value":"application/json"}], "body": { "mode":"raw","raw":"{\n  \"courseId\": \"course-6006\",\n  \"orgId\": \"org-mit\",\n  \"tenantId\": \"tenant_mit\"\n}" } } },
      { "name": "BELONGS_TO",       "request": { "method": "POST", "url": "{{base}}/relationships/belongs-to",      "header": [{"key":"Content-Type","value":"application/json"}], "body": { "mode":"raw","raw":"{\n  \"departmentId\": \"dept-mit-cs\",\n  \"orgId\": \"org-mit\",\n  \"tenantId\": \"tenant_mit\"\n}" } } },
      { "name": "Get Person Rels",         "request": { "method": "GET",    "url": "{{base}}/relationships/person/person-sarah-chen" } },
      { "name": "Get Person Rels (tenant)","request": { "method": "GET",    "url": "{{base}}/relationships/person/person-sarah-chen/tenant/tenant_mit" } },
      { "name": "Delete ENROLLED_IN",      "request": { "method": "DELETE", "url": "{{base}}/relationships/enrolled-in/person-sarah-chen/org-mit/tenant_mit" } },
      { "name": "Delete WORKS_AT",         "request": { "method": "DELETE", "url": "{{base}}/relationships/works-at/person-sarah-chen/org-google/tenant_google" } }
    ]},
    { "name": "Promotions", "item": [
      { "name": "Get Person Labels",     "request": { "method": "GET",  "url": "{{base}}/promotions/person/person-sarah-chen/labels" } },
      { "name": "Promote to Student",    "request": { "method": "POST", "url": "{{base}}/promotions/person/person-sarah-chen/student",    "header": [{"key":"Content-Type","value":"application/json"}], "body": { "mode":"raw","raw":"{\n  \"studentId\": \"MIT-2019-001\",\n  \"gpa\": 3.9,\n  \"enrollmentYear\": 2019,\n  \"enrollmentStatus\": \"Graduated\",\n  \"studyMode\": \"Full-time\"\n}" } } },
      { "name": "Promote to Employee",   "request": { "method": "POST", "url": "{{base}}/promotions/person/person-sarah-chen/employee",   "header": [{"key":"Content-Type","value":"application/json"}], "body": { "mode":"raw","raw":"{\n  \"employeeNumber\": \"G-44001\",\n  \"contractType\": \"Permanent\",\n  \"salaryBand\": \"L4\",\n  \"department\": \"Cloud\"\n}" } } },
      { "name": "Promote to Resident",   "request": { "method": "POST", "url": "{{base}}/promotions/person/person-leon-fischer/resident",  "header": [{"key":"Content-Type","value":"application/json"}], "body": { "mode":"raw","raw":"{\n  \"residentId\": \"NL-AMS-001234\",\n  \"registrationDate\": \"2022-01-15\",\n  \"residencyType\": \"Expat\"\n}" } } },
