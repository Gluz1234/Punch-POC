    { "name": "Dynamic (New Types)", "item": [
      { "name": "Create Volunteer node",       "request": { "method": "POST",   "url": "{{base}}/dynamic/nodes",                                          "header": [{"key":"Content-Type","value":"application/json"}], "body": { "mode":"raw","raw":"{\n  \"labels\": [\"Volunteer\"],\n  \"idField\": \"volunteer_id\",\n  \"id\": \"vol-001\",\n  \"createConstraint\": true,\n  \"properties\": {\n    \"name\": \"Community Helper\",\n    \"area\": \"Education\",\n    \"hours_committed\": 40,\n    \"tenant_id\": \"tenant_ngo\"\n  }\n}" } } },
      { "name": "Create ResearchProject node", "request": { "method": "POST",   "url": "{{base}}/dynamic/nodes",                                          "header": [{"key":"Content-Type","value":"application/json"}], "body": { "mode":"raw","raw":"{\n  \"labels\": [\"ResearchProject\"],\n  \"idField\": \"project_id\",\n  \"id\": \"proj-ml-001\",\n  \"createConstraint\": true,\n  \"properties\": {\n    \"title\": \"Graph ML for Urban Planning\",\n    \"status\": \"Active\",\n    \"budget\": 250000\n  }\n}" } } },
      { "name": "Create multi-label node",     "request": { "method": "POST",   "url": "{{base}}/dynamic/nodes",                                          "header": [{"key":"Content-Type","value":"application/json"}], "body": { "mode":"raw","raw":"{\n  \"labels\": [\"Asset\", \"ITEquipment\"],\n  \"idField\": \"asset_id\",\n  \"id\": \"asset-laptop-001\",\n  \"createConstraint\": true,\n  \"properties\": {\n    \"model\": \"MacBook Pro M3\",\n    \"tenant_id\": \"tenant_google\"\n  }\n}" } } },
      { "name": "Get all Volunteer nodes",     "request": { "method": "GET",    "url": "{{base}}/dynamic/nodes/Volunteer" } },
      { "name": "Get one Volunteer",           "request": { "method": "GET",    "url": "{{base}}/dynamic/nodes/Volunteer/volunteer_id/vol-001" } },
      { "name": "Update Volunteer",            "request": { "method": "PUT",    "url": "{{base}}/dynamic/nodes/Volunteer/volunteer_id/vol-001",            "header": [{"key":"Content-Type","value":"application/json"}], "body": { "mode":"raw","raw":"{\n  \"properties\": {\n    \"hours_committed\": 80,\n    \"status\": \"Active\"\n  }\n}" } } },
      { "name": "Add extra label",             "request": { "method": "POST",   "url": "{{base}}/dynamic/nodes/Volunteer/volunteer_id/vol-001/labels",     "header": [{"key":"Content-Type","value":"application/json"}], "body": { "mode":"raw","raw":"{\n  \"newLabel\": \"CommunityProgram\"\n}" } } },
      { "name": "Delete Volunteer node",       "request": { "method": "DELETE", "url": "{{base}}/dynamic/nodes/Volunteer/volunteer_id/vol-001" } },
      { "name": "Connect Person→Volunteer",    "request": { "method": "POST",   "url": "{{base}}/dynamic/relationships",                                   "header": [{"key":"Content-Type","value":"application/json"}], "body": { "mode":"raw","raw":"{\n  \"fromLabel\": \"Person\",\n  \"fromIdField\": \"strong_id\",\n  \"fromId\": \"person-sarah-chen\",\n  \"toLabel\": \"Volunteer\",\n  \"toIdField\": \"volunteer_id\",\n  \"toId\": \"vol-001\",\n  \"type\": \"IS_VOLUNTEER\",\n  \"properties\": {\n    \"tenant_id\": \"tenant_ngo\",\n    \"role\": \"Coordinator\"\n  }\n}" } } },
      { "name": "Connect Person→Project",      "request": { "method": "POST",   "url": "{{base}}/dynamic/relationships",                                   "header": [{"key":"Content-Type","value":"application/json"}], "body": { "mode":"raw","raw":"{\n  \"fromLabel\": \"Person\",\n  \"fromIdField\": \"strong_id\",\n  \"fromId\": \"person-sarah-chen\",\n  \"toLabel\": \"ResearchProject\",\n  \"toIdField\": \"project_id\",\n  \"toId\": \"proj-ml-001\",\n  \"type\": \"WORKS_ON\",\n  \"properties\": {\n    \"tenant_id\": \"tenant_mit\",\n    \"role\": \"Lead Researcher\"\n  }\n}" } } },
      { "name": "Get node relationships",      "request": { "method": "GET",    "url": "{{base}}/dynamic/relationships/Person/strong_id/person-sarah-chen?direction=out" } },
      { "name": "Delete dynamic relationship", "request": { "method": "DELETE", "url": "{{base}}/dynamic/relationships",                                   "header": [{"key":"Content-Type","value":"application/json"}], "body": { "mode":"raw","raw":"{\n  \"fromLabel\": \"Person\",\n  \"fromIdField\": \"strong_id\",\n  \"fromId\": \"person-sarah-chen\",\n  \"toLabel\": \"Volunteer\",\n  \"toIdField\": \"volunteer_id\",\n  \"toId\": \"vol-001\",\n  \"type\": \"IS_VOLUNTEER\"\n}" } } }
    ]},
