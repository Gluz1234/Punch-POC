{
  "info": { "name": "Knowledge Graph Admin API v2 (Generic)", "description": "Multi-Tenant Knowledge Graph API with dynamically generated endpoints. All standard entities (Person, Organization, Location, Skill, Education, Course, Department) are served by a single generic service with configuration-driven routes.", "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json" },
  "variable": [{ "key": "base", "value": "http://localhost:3000/api" }],
  "item": [
    { "name": "Persons", "item": [
      { "name": "Create Person", "request": { "method": "POST", "url": "{{base}}/persons", "header": [{"key":"Content-Type","value":"application/json"}], "body": { "mode": "raw", "raw": "{\n  \"strongId\": \"person-sarah-chen\",\n  \"firstName\": \"Sarah\",\n  \"lastName\": \"Chen\",\n  \"email\": \"sarah.chen@gmail.com\",\n  \"nationality\": \"American\",\n  \"status\": \"Active\"\n}" } } },
      { "name": "Get All Persons",  "request": { "method": "GET",    "url": "{{base}}/persons" } },
      { "name": "Get One Person",   "request": { "method": "GET",    "url": "{{base}}/persons/person-sarah-chen" } },
      { "name": "Update Person",    "request": { "method": "PUT",    "url": "{{base}}/persons/person-sarah-chen", "header": [{"key":"Content-Type","value":"application/json"}], "body": { "mode":"raw","raw":"{\n  \"firstName\": \"Sarah\",\n  \"lastName\": \"Chen\",\n  \"email\": \"sarah.chen@google.com\",\n  \"status\": \"Active\"\n}" } } },
      { "name": "Delete Person",    "request": { "method": "DELETE", "url": "{{base}}/persons/person-to-delete" } }
    ]},
    { "name": "Organizations", "item": [
      { "name": "Create Org",    "request": { "method": "POST",   "url": "{{base}}/organizations", "header": [{"key":"Content-Type","value":"application/json"}], "body": { "mode":"raw","raw":"{\n  \"orgId\": \"org-mit\",\n  \"name\": \"MIT\",\n  \"organizationType\": \"University\",\n  \"industry\": \"Education\"\n}" } } },
      { "name": "Get All Orgs",  "request": { "method": "GET",    "url": "{{base}}/organizations" } },
      { "name": "Get One Org",   "request": { "method": "GET",    "url": "{{base}}/organizations/org-mit" } },
      { "name": "Delete Org",    "request": { "method": "DELETE", "url": "{{base}}/organizations/org-to-delete" } }
    ]},
    { "name": "Locations", "item": [
      { "name": "Create Location","request": { "method": "POST", "url": "{{base}}/locations", "header": [{"key":"Content-Type","value":"application/json"}], "body": { "mode":"raw","raw":"{\n  \"locationId\": \"loc-amsterdam\",\n  \"name\": \"Amsterdam\",\n  \"locationType\": \"City\",\n  \"latitude\": 52.3676,\n  \"longitude\": 4.9041\n}" } } },
      { "name": "Get All Locations","request": { "method": "GET", "url": "{{base}}/locations" } },
      { "name": "Get One Location", "request": { "method": "GET", "url": "{{base}}/locations/loc-amsterdam" } }
    ]},
    { "name": "Skills", "item": [
      { "name": "Create Skill",  "request": { "method": "POST", "url": "{{base}}/skills", "header": [{"key":"Content-Type","value":"application/json"}], "body": { "mode":"raw","raw":"{\n  \"skillId\": \"skill-python\",\n  \"name\": \"Python\",\n  \"category\": \"Programming Language\"\n}" } } },
      { "name": "Get All Skills","request": { "method": "GET",  "url": "{{base}}/skills" } },
      { "name": "Get One Skill", "request": { "method": "GET",  "url": "{{base}}/skills/skill-python" } }
    ]},
    { "name": "Education", "item": [
      { "name": "Create Education","request": { "method": "POST", "url": "{{base}}/education", "header": [{"key":"Content-Type","value":"application/json"}], "body": { "mode":"raw","raw":"{\n  \"educationId\": \"edu-cs-mit\",\n  \"title\": \"BSc Computer Science\",\n  \"educationType\": \"Degree\",\n  \"fieldOfStudy\": \"Computer Science\"\n}" } } },
      { "name": "Get All Education","request": { "method": "GET", "url": "{{base}}/education" } }
    ]},
    { "name": "Courses", "item": [
      { "name": "Create Course",    "request": { "method": "POST", "url": "{{base}}/courses", "header": [{"key":"Content-Type","value":"application/json"}], "body": { "mode":"raw","raw":"{\n  \"courseId\": \"course-6006\",\n  \"orgId\": \"org-mit\",\n  \"name\": \"Introduction to Algorithms\",\n  \"code\": \"6.006\",\n  \"credits\": 12,\n  \"level\": \"Undergraduate\"\n}" } } },
      { "name": "Get All Courses",  "request": { "method": "GET",  "url": "{{base}}/courses" } },
      { "name": "Courses by Org",   "request": { "method": "GET",  "url": "{{base}}/courses/by-org/org-mit" } }
    ]},
    { "name": "Departments", "item": [
      { "name": "Create Dept",      "request": { "method": "POST", "url": "{{base}}/departments", "header": [{"key":"Content-Type","value":"application/json"}], "body": { "mode":"raw","raw":"{\n  \"departmentId\": \"dept-mit-cs\",\n  \"orgId\": \"org-mit\",\n  \"name\": \"Dept. of EECS\",\n  \"code\": \"EECS\"\n}" } } },
      { "name": "Get All Depts",    "request": { "method": "GET",  "url": "{{base}}/departments" } },
      { "name": "Depts by Org",     "request": { "method": "GET",  "url": "{{base}}/departments/by-org/org-mit" } }
    ]},
    { "name": "Relationships", "item": [
